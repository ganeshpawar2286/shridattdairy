<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" width="600" height="450" viewBox="0 0 600 450">
  <defs>
    <linearGradient id="bg_lassi" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#F3E5F5" />
      <stop offset="100%" stop-color="#E1BEE7" />
    </linearGradient>
    <linearGradient id="badge_lassi" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#1b5e20" />
      <stop offset="100%" stop-color="#2e7d32" />
    </linearGradient>
  </defs>

  <rect width="600" height="450" fill="url(#bg_lassi)" rx="16" />

  <circle cx="500" cy="80" r="140" fill="#ffffff" opacity="0.3" />
  <circle cx="80" cy="380" r="160" fill="#ffffff" opacity="0.3" />

  <rect x="150" y="70" width="300" height="230" fill="#ffffff" rx="20" opacity="0.95" />
  
  <text x="300" y="195" font-size="90" text-anchor="middle" dominant-baseline="middle">🥤</text>

  <text x="300" y="350" font-family="Arial, sans-serif" font-size="32" font-weight="bold" fill="#7B1FA2" text-anchor="middle">Lassi</text>
  <text x="300" y="385" font-family="Arial, sans-serif" font-size="17" font-weight="bold" fill="#444444" text-anchor="middle">Sweet Churned Cream Lassi</text>

  <rect x="20" y="20" width="160" height="36" fill="url(#badge_lassi)" rx="18" />
  <text x="100" y="43" font-family="Arial, sans-serif" font-size="13" font-weight="bold" fill="#ffffff" text-anchor="middle">100% PURE DAIRY</text>
</svg>